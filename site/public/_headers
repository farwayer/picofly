# everything vite puts in /assets carries a content hash in its name, so a
# new build is a new url and the old one can be kept forever. Without this
# Workers serves assets as `max-age=0, must-revalidate`, and the logo goes
# blank for the length of the 304 every time the main page is mounted
/assets/*
  Cache-Control: public, max-age=31536000, immutable
